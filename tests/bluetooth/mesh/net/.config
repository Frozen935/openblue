CONFIG_BT_BUF_EVT_DISCARDABLE_COUNT=3
CONFIG_BT_BUF_CMD_TX_SIZE=255
CONFIG_BT_BUF_CMD_TX_COUNT=3
CONFIG_BT_BUF_SYNC_EVT_POOL_COUNT=1
CONFIG_BT_HCI_TX_STACK_SIZE=1024
CONFIG_BT_HCI_TX_PRIO=7
# CONFIG_BT_RECV_WORKQ_SYS is not set
CONFIG_BT_RECV_WORKQ_BT=y
CONFIG_BT_RX_STACK_SIZE=4096
CONFIG_BT_RX_PRIO=8
CONFIG_BT_DRIVER_RX_HIGH_PRIO=6
CONFIG_BT_DEVICE_NAME="OpenBlue"
CONFIG_BT_DEVICE_APPEARANCE=0
CONFIG_BT_ID_MAX=1
CONFIG_BT_MESH=y
CONFIG_BT_MESH_ADV_LEGACY=y
CONFIG_BT_MESH_ADV_BUF_COUNT=6
CONFIG_BT_MESH_ADV_STACK_SIZE=776
CONFIG_BT_MESH_ADV_PRIO=7
CONFIG_BT_MESH_PB_ADV=y
CONFIG_BT_MESH_PB_ADV_TRANS_PDU_RETRANSMIT_COUNT=0
CONFIG_BT_MESH_PB_ADV_TRANS_ACK_RETRANSMIT_COUNT=2
CONFIG_BT_MESH_PB_ADV_LINK_CLOSE_RETRANSMIT_COUNT=2
CONFIG_BT_MESH_PB_ADV_RETRANS_TIMEOUT=500
CONFIG_BT_MESH_UNPROV_BEACON_INT=5
CONFIG_BT_MESH_DEFAULT_TTL=7
CONFIG_BT_MESH_NETWORK_TRANSMIT_COUNT=2
CONFIG_BT_MESH_NETWORK_TRANSMIT_INTERVAL=20
CONFIG_BT_MESH_MSG_CACHE_SIZE=32
CONFIG_BT_MESH_LOOPBACK_BUFS=3
CONFIG_BT_MESH_CRPL=10
CONFIG_BT_MESH_TX_SEG_MSG_COUNT=1
CONFIG_BT_MESH_RX_SEG_MSG_COUNT=1
CONFIG_BT_MESH_SEG_BUFS=64
CONFIG_BT_MESH_SUBNET_COUNT=1
CONFIG_BT_MESH_APP_KEY_COUNT=1
CONFIG_BT_MESH_MODEL_KEY_COUNT=1
CONFIG_BT_MESH_MODEL_GROUP_COUNT=1
CONFIG_BT_MESH_LABEL_COUNT=1
CONFIG_BT_MESH_COMP_PST_BUF_SIZE=100
CONFIG_BT_MESH_SEQ_STORE_RATE=128
CONFIG_BT_MESH_IVU_DIVIDER=4
CONFIG_BT_MESH_IV_UPDATE_SEQ_LIMIT=0x800000
CONFIG_BT_MESH_SAR_TX_SEG_INT_STEP=0x05
