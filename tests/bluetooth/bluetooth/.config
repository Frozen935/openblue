CONFIG_NUM_PREEMPT_PRIORITIES=16
CONFIG_OPENBLUE_SYSTEM_WORKQUEUE_STACK_SIZE=2048
# CONFIG_BIG_ENDIAN is not set
CONFIG_LITTLE_ENDIAN=y
CONFIG_OPENBLUE_CRYPTO_USE_MBEDTLS=y
CONFIG_OPENBLUE_TESTS=y
CONFIG_OPENBLUE_PLATFORM_LINUX=y
# CONFIG_OPENBLUE_BT_DRIVER is not set
CONFIG_BT=y
CONFIG_BT_HCI=y
CONFIG_BT_HCI_HOST=y
CONFIG_BT_HOST_CRYPTO=y
CONFIG_BT_HOST_CRYPTO_PRNG=y
CONFIG_BT_BUF_ACL_TX_SIZE=1024
CONFIG_BT_BUF_ACL_TX_COUNT=16
CONFIG_BT_BUF_ACL_RX_SIZE=1024
CONFIG_BT_BUF_ACL_RX_COUNT_EXTRA=16
CONFIG_BT_BUF_EVT_RX_SIZE=255
CONFIG_BT_BUF_EVT_RX_COUNT=20
CONFIG_BT_BUF_EVT_DISCARDABLE_SIZE=255
CONFIG_BT_BUF_EVT_DISCARDABLE_COUNT=3
CONFIG_BT_BUF_CMD_TX_SIZE=255
CONFIG_BT_BUF_CMD_TX_COUNT=3
CONFIG_BT_BUF_SYNC_EVT_POOL_COUNT=1
CONFIG_BT_HCI_TX_STACK_SIZE=1024
CONFIG_BT_HCI_TX_PRIO=7
# CONFIG_BT_RECV_WORKQ_SYS is not set
CONFIG_BT_RECV_WORKQ_BT=y
CONFIG_BT_RX_STACK_SIZE=4096
CONFIG_BT_RX_PRIO=8
CONFIG_BT_DRIVER_RX_HIGH_PRIO=6
CONFIG_BT_DEVICE_NAME="OpenBlue"
CONFIG_BT_DEVICE_APPEARANCE=0
CONFIG_BT_ID_MAX=1
